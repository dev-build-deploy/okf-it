{
  "name": "@dev-build-deploy/okf-it",
  "version": "0.0.0",
  "description": "Open Knowledge Format (OKF) library: read, check and write knowledge bundles",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "okf-it": "bin/okf-it"
  },
  "scripts": {
    "build": "tsc --project tsconfig.publish.json",
    "prepublishOnly": "tsc --project tsconfig.publish.json",
    "test": "jest --coverage",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "node -e \"if(process.env.CI)process.exit(0);const r=require('child_process').spawnSync('pre-commit',['install','--hook-type','pre-commit','--hook-type','commit-msg'],{stdio:'inherit'});if(r.error)console.log('hint: install pre-commit (https://pre-commit.com) to get the git hooks')\""
  },
  "author": "Kevin de Jong",
  "license": "MIT",
  "keywords": [
    "OKF",
    "Open Knowledge Format",
    "knowledge",
    "markdown",
    "front matter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-build-deploy/okf-it.git"
  },
  "bugs": {
    "url": "https://github.com/dev-build-deploy/okf-it/issues"
  },
  "homepage": "https://github.com/dev-build-deploy/okf-it#readme",
  "files": [
    "lib/**/*",
    "bin/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
